<?xml version="1.0"?>
<launch>

    <arg name="initial_controller" default="cart" description="Initially active controller (jnt, cart)." />
    <arg name="use_moveit" default="true" />
    <let name="use_cart" value="true" />

    <let name="jnt_active" value="--activate-as-group"
        if="$(eval '\'$(var initial_controller)\' == \'jnt\'')"/>
    <let name="jnt_active" value="--inactive"
        unless="$(eval '\'$(var initial_controller)\' == \'jnt\'')"/>

    <let name="cart_active" value="--activate-as-group"
        if="$(eval '\'$(var initial_controller)\' == \'cart\'')"/>
    <let name="cart_active" value="--inactive"
        unless="$(eval '\'$(var initial_controller)\' == \'cart\'')"/>

    <!-- Spawn Velma -->
    <include file="$(find-pkg-share wut_velma_gazebo)/launch/internal/_spawn_velma.launch.py"/>

    <!-- Robot state publisher -->
    <include file="$(find-pkg-share wut_velma_gazebo)/launch/internal/_robot_state_publisher.launch.py">
        <arg name="use_sim_time" value="true" />
    </include>

    <!-- joint_state_broadcaster spawner -->
    <node
        pkg="controller_manager"
        exec="spawner"
        output="screen"
        args="joint_state_broadcaster -c /controller_manager" />

    <!-- Load cascade of regulators for joint impedance -->
    <node pkg="controller_manager"
            exec="spawner"
            name="spawner_arm_cascade"
            output="screen"
            args="
                arms_torso_effort_jnt
                arms_torso_trajectory_controller_jnt
                $(var jnt_active)
                --controller-manager /controller_manager
                --controller-manager-timeout 10
                --switch-timeout 10"/>

    <!-- Load regulator for Cartesian impedance -->
    <node pkg="controller_manager"
            exec="spawner"
            name="spawner_cartesian_cascade_inactive"
            output="screen"
            args="
                cartesian_controller
                $(var cart_active)
                --controller-manager /controller_manager
                --controller-manager-timeout 10
                --switch-timeout 10"
            if="$(var use_cart)" />


    <node pkg="controller_manager"
            exec="spawner"
            name="spawner_head_hands_controller"
            output="screen"
            args="
                head_controller
                left_hand_controller
                right_hand_controller
                --activate-as-group
                --controller-manager /controller_manager
                --controller-manager-timeout 10
                --switch-timeout 10"/>

    <!-- MoveIt -->
    <arg name="launch_moveit_rviz" default="true"/>

    <!-- Run MoveIt: /move_group -->
    <include file="$(find-pkg-share velma_moveit_config)/launch/move_group.launch.py" if="$(var use_moveit)">
        <arg name="use_sim_time" value="true"/>
    </include>

    <!-- Run RViz with the specified config file. -->
    <include
        if="$(var launch_moveit_rviz)"
        file="$(find-pkg-share velma_moveit_config)/launch/moveit_rviz.launch.py">
        <arg name="use_sim_time" value="true"/>
    </include>

</launch>
