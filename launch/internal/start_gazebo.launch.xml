<?xml version="1.0"?>
<launch>
    <!-- For solving rendering problems under Virtual Box: old_ogre:=true -->
    <arg name="old_ogre" default="false" />

    <!-- For running Gazebo Client -->
    <arg name="run_gui" default="true" />

    <!-- <let name="world_name" value="empty_world.world" /> -->
    <arg name="world_name" default="world_table.world" />

    <arg name="verbose" default="4" description="Gazebo verbosity level (0-4)." />

    <!-- Environment variables for Gazebo Sim -->
    <set_env
        name="GZ_SIM_RESOURCE_PATH"
        value="$(find-pkg-prefix velma_description)/share:$(find-pkg-share wut_gazebo_models)/models:$(env GZ_SIM_RESOURCE_PATH '')" />

    <set_env
        name="IGN_GAZEBO_RESOURCE_PATH"
        value="$(find-pkg-prefix velma_description)/share:$(env IGN_GAZEBO_RESOURCE_PATH '')" />

    <set_env
        name="GZ_SIM_SYSTEM_PLUGIN_PATH"
        value="$(find-pkg-prefix wut_velma_effort_controller)/lib:$(env GZ_SIM_SYSTEM_PLUGIN_PATH '')" />

    <!-- Gazebo Sim server -->
    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg
        name="gz_args"
        value="-r -s -v2 $(find-pkg-share wut_velma_gazebo)/worlds/$(var world_name) -v $(var verbose)" />
        <arg
        name="on_exit_shutdown"
        value="true" />
    </include>

    <!-- Gazebo Sim client -->
    <include file="$(find-pkg-share wut_velma_gazebo)/launch/start_gazebo_client.launch.xml" if="$(var run_gui)">
        <arg name="old_ogre" value="$(var old_ogre)"/>
    </include>

    <!-- ROS-Gazebo bridge -->
    <node
        pkg="ros_gz_bridge"
        exec="parameter_bridge"
        output="screen"
        args="--ros-args -p config_file:=$(find-pkg-share wut_velma_gazebo)/params/velma_bridge.yaml" />

    <!-- Image bridge -->
    <!-- TODO: is this required? -->
    <!-- <node
        pkg="ros_gz_image"
        exec="image_bridge"
        output="screen"
        args="/camera/image_raw" /> -->

    <!-- Run the node for getting posed of objects from Gazebo Sim. -->
    <node pkg="gazebo_pose_tools" exec="gazebo_pose_service_node" output="screen">
        <param name="use_sim_time" value="true"/>
    </node>

</launch>
